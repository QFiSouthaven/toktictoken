# Node A (Bosgame M5) — environment template
# Copy to `.env` and fill in. Never commit `.env`.
#
# Generate strong secrets with:  openssl rand -hex 32

# --- Hostnames (Caddyfile uses these) ---
N8N_HOST=n8n.bosgame.local
CHAT_HOST=chat.bosgame.local
DIFY_HOST=dify.bosgame.local
LITELLM_HOST=api.bosgame.local
LETTA_HOST=letta.bosgame.local
KUMA_HOST=status.bosgame.local

# --- Timezone ---
TZ=America/New_York

# --- Secrets (REPLACE all of these) ---
POSTGRES_PASSWORD=changeme-openssl-rand-hex-32
LITELLM_MASTER_KEY=sk-litellm-changeme-openssl-rand-hex-32
LITELLM_SALT_KEY=changeme-openssl-rand-hex-32
N8N_ENCRYPTION_KEY=changeme-openssl-rand-hex-32

# --- llama-server (primary big-model) ---
# Path on the host where GGUFs live. Symlink /mnt/nvme/models if 2 TB drive is separate.
MODELS_DIR=/mnt/nvme/models
# Filename of the primary model in $MODELS_DIR. Pull via scripts/pull-models.sh.
PRIMARY_MODEL_GGUF=Qwen3-30B-A3B-Q4_K_M.gguf
# 999 = offload all layers to iGPU (Strix Halo unified memory makes this safe).
NGL=999
# 32k is a sweet spot for Strix Halo unified memory + Q8 KV cache.
CTX=32768
# Concurrent requests served from one model instance.
PARALLEL=2
# CPU threads for prompt prep / non-GPU ops. Strix Halo has 16C/32T.
THREADS=12

# --- Open WebUI ---
DEFAULT_MODELS=default-smart

# --- Watchtower (auto-update schedule, cron format with seconds) ---
WATCHTOWER_SCHEDULE=0 0 4 * * SUN
