# systemd unit for bare-metal llama-server on Node A.
# Use this only if running outside Docker (see ../llama-server/run.sh).
#
# Install:
#   sudo cp llama-server.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now llama-server

[Unit]
Description=llama.cpp server (Vulkan/AMDVLK) — primary inference on Node A
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ai
Group=ai
SupplementaryGroups=video render
EnvironmentFile=/etc/llama-server.env
ExecStart=/srv/ai/llama-server/run.sh
Restart=always
RestartSec=5
LimitNOFILE=65536

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/mnt/nvme/models /var/log/llama-server
DeviceAllow=/dev/dri/* rw

[Install]
WantedBy=multi-user.target
