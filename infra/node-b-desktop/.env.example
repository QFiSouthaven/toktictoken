# Node B (RTX 4070 desktop) — environment template
# Copy to `.env`. Never commit `.env`.

# Where GGUFs live on the host. Sync via scripts/pull-models.sh.
MODELS_DIR=/mnt/models

# --- Fast chat model (12 GB VRAM headroom) ---
# Q4_K_M of an 8B model fits comfortably with 16k ctx + Q8 KV.
FAST_MODEL_GGUF=Qwen3-8B-Instruct-Q4_K_M.gguf
FAST_CTX=16384

# --- Embedding model ---
# bge-m3 multilingual is the strong default for 2026.
EMBED_MODEL_GGUF=bge-m3-Q8_0.gguf
EMBED_CTX=8192

# --- Reranker (profile=full) ---
RERANK_MODEL_GGUF=bge-reranker-v2-m3-Q8_0.gguf

# --- RPC worker (profile=cluster, Phase 5) ---
# How much VRAM (MiB) to reserve for tensors when running in cluster mode.
RPC_RESERVE_MIB=10240
