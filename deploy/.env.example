# Copy to deploy/.env and fill in.
# Generate JWT_SECRET with:  openssl rand -hex 48
# Generate ADMIN_PASSWORD_HASH with:
#   node -e "console.log(require('bcrypt').hashSync(process.argv[1], 12))" 'yourpassword'

DOMAIN=chat.example.com
LETSENCRYPT_EMAIL=you@example.com

JWT_SECRET=
ADMIN_PASSWORD_HASH=

# If LM Studio runs on the VPS host (default), keep as-is.
# If LM Studio is elsewhere, set the full URL reachable from the container.
LM_STUDIO_URL=http://host.docker.internal:1234
